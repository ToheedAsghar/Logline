# Github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Github Test PAT
GITHUB_TEST_PAT=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Google Calender
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Jira
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# postgres
DATABASE_URL=

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173

# Frontend base URL (used to build links in verification/reset emails)
FRONTEND_BASE_URL=http://localhost:5173

# Anthropic
ANTHROPIC_API_KEY=

# LLM provider (agent runner)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Field-level encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# JWT auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Signs email-verification tokens (itsdangerous)
ITSDANGEROUS_SECRET_KEY=

# Email (SMTP) -- all required, app fails to start if any are missing
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
