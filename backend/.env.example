# === Required (app fails to start if missing) ===

# postgres
DATABASE_URL=

# JWT auth
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# Signs email-verification/password-reset tokens (itsdangerous). Deliberately a separate secret from
# JWT_SECRET_KEY -- generate the same way, but with a different value:
# python -c "import secrets; print(secrets.token_hex(32))"
ITSDANGEROUS_SECRET_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Google Calendar / Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Required in production (defaults fine for local dev) ===

# Backend base URL (used to build the connect_url returned by
# POST /integrations/{source}/connect-link, and to derive OAuth redirect URIs -- see bottom of file)
BACKEND_BASE_URL=http://localhost:8000

# Frontend base URL (used to build links in verification/reset emails)
FRONTEND_BASE_URL=http://localhost:5173

# === Optional (realistically overridden) ===

# Github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Github Test PAT
GITHUB_TEST_PAT=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Jira
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173

# Anthropic
ANTHROPIC_API_KEY=

# LLM provider (agent runner)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Field-level encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# OAuth redirect URIs (GITHUB_REDIRECT_URI, SLACK_REDIRECT_URI, JIRA_REDIRECT_URI, GOOGLE_REDIRECT_URI) are
# auto-derived from BACKEND_BASE_URL + the provider's callback path. Only set one of these if that provider
# needs a callback path different from the default.
